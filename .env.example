# Required to sign in. No defaults. Generate AUTH_SECRET with:
#   openssl rand -base64 48
# AUTH_SECRET must be at least 32 characters.
# AUTH_PASSWORD must be at least 12 characters.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD=replace-with-a-long-unique-password

# Optional. Session lifetime in days (1–90). Defaults to 7.
# AUTH_SESSION_DAYS=7

# Generation platform (server only). Without these, the studio opens but Generate fails.
# Get an id:secret key from the generation platform. Never commit the real key.
HF_API_BASE_URL=https://platform.higgsfield.ai
HF_API_KEY=id:secret

# Optional. Vercel Blob read-write token for publicly fetchable uploads.
# If unset, files are stored on local disk (ephemeral in containers).
# OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# Optional. Public origin of this studio, used to build upload URLs the generation
# API can fetch. Required for image-to-video / references when not using Blob.
# Example behind a reverse proxy: https://studio.example.com
# PUBLIC_ORIGIN=

# Optional. Canonical URL used in metadata. Defaults to http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional. Force Secure cookies (1) or allow HTTP cookies (0).
# If unset: https PUBLIC_ORIGIN → Secure; http PUBLIC_ORIGIN → not Secure;
# otherwise Secure in production.
# AUTH_COOKIE_SECURE=

# Optional. Set to 1 when running behind a reverse proxy that sets X-Forwarded-*.
# TRUST_PROXY=

# Optional. Local upload directory when Blob is not configured.
# UPLOAD_DIR=/tmp/open-higgsfield-uploads
